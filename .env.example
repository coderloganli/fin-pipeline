# Copy to .env and edit if you need something other than the defaults.
# These values match the defaults in compose.yaml; a test asserts they agree.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fin_pipeline
POSTGRES_USER=fin_pipeline
POSTGRES_PASSWORD=fin_pipeline

# Where the mart lives. `landing` holds what transform/load.py copies from the staging
# Parquet, and `mart` holds what dbt builds on top of it. The first is not called
# staging because docs/adr/0026 already owns that name for the Parquet layer.
# See docs/adr/0034.
POSTGRES_LANDING_SCHEMA=landing
POSTGRES_MART_SCHEMA=mart
